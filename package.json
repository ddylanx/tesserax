{
  "name": "open-tesseract",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "init:data": "node scripts/init-data.mjs",
    "dev": "node scripts/init-data.mjs && pnpm db:up && turbo run dev",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:up": "docker compose -f infra/compose.dev.yml up -d --wait",
    "db:down": "docker compose -f infra/compose.dev.yml down",
    "db:migrate": "pnpm --filter @ot/db migrate",
    "db:seed": "pnpm --filter @ot/db seed",
    "hooks:print": "node scripts/claude-hooks.mjs print",
    "hooks:install": "node scripts/claude-hooks.mjs install",
    "hooks:uninstall": "node scripts/claude-hooks.mjs uninstall",
    "fake-jira": "node scripts/fake-jira.mjs",
    "jira:check": "node scripts/jira-check.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "turbo": "^2.5.8",
    "typescript": "~5.9.3"
  }
}

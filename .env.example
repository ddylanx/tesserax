# Copy to .env (gitignored). Only the first block is needed to start.
NODE_ENV=development
LOG_LEVEL=info
API_HOST=127.0.0.1
API_PORT=4400
WEB_PORT=5180
DATABASE_URL=postgres://ot:ot@127.0.0.1:54329/open_tesseract

# Jira Cloud, read-only (milestone 4). Token: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
# Optional: which issues to sync (default: assigned to you, not done, or updated in the last 14 days)
JIRA_JQL=
# Which seeded workspace Jira tasks belong to: personal | company
JIRA_WORKSPACE=company

# Telegram bot, read-only, long polling (milestone 5). Token from @BotFather.
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram user ids allowed to talk to the bot
TELEGRAM_ALLOWED_USER_IDS=

# MCP page: path to the existing agent-cockpit MCP reader (default: ../agent-cockpit/src/mcp.mjs).
# If missing, a built-in Claude Code-only reader is used.
AGENT_COCKPIT_MCP_PATH=

# Automation pipeline
CLAUDE_BIN=claude
PLAYBOOK_TIMEOUT_SECONDS=1800
WEB_BASE_URL=http://127.0.0.1:5180
# Classification: claude-cli (local `claude -p`, falls back to rules) | rules
CLASSIFIER_ENGINE=claude-cli
CLASSIFIER_MODEL=sonnet
# What a new Jira issue starts: workflow (default) | pipeline (older Inbox flow) | off
AUTO_START=workflow
